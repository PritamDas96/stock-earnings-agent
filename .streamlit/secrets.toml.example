# Streamlit secrets template.
#
# Local use: copy this file to `.streamlit/secrets.toml` and fill in your keys
#   (that real file is gitignored and never pushed).
# Streamlit Community Cloud: open your app, then Manage app > Settings > Secrets,
#   and paste the same content (without the ".example" suffix).

GROQ_API_KEY = "your_groq_api_key_here"
GOOGLE_API_KEY = "your_google_api_key_here"

# Optional overrides (defaults shown):
# GROQ_MODEL = "qwen/qwen3.8-27b"
# LLM_MAX_TOKENS = "800"
