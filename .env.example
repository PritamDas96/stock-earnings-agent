# Copy to `.env` and fill in your keys.  Required values have no default.

# --- Required credentials ---
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- LLM (optional overrides) ---
# Must be a tool-calling model available to your Groq account.
GROQ_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.1
# Keep <= your account's per-request output-token limit (Groq free tier is low).
LLM_MAX_TOKENS=800

# --- Embeddings (optional overrides) ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
EMBEDDING_BATCH_SIZE=16

# --- Vector store (optional overrides) ---
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=earnings_documents

# --- Chunking / retrieval (optional overrides) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# --- Misc (optional overrides) ---
HTTP_TIMEOUT=30
SEC_USER_AGENT=StockEarningsAgent/1.0 (you@example.com)
LOG_LEVEL=INFO
